# ──────────────────────────────────────────────────────────────────────────────
# Kopieer dit bestand naar .env.local en vul je eigen waarden in.
# Het bestand .env.local staat in .gitignore en wordt NOOIT naar GitHub gepusht.
# ──────────────────────────────────────────────────────────────────────────────

# Supabase project URL (te vinden in Supabase → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://jouw-project-id.supabase.co

# Supabase anonieme sleutel (publiek, veilig voor de browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=jouw-anon-key-hier

# Supabase service role sleutel (ALLEEN server-side gebruiken, nooit in de browser!)
SUPABASE_SERVICE_ROLE_KEY=jouw-service-role-key-hier
