# ============================================================
# Fightsupport - Environment Variables Example
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ------------------------------------
# Supabase (REQUIRED)
# ------------------------------------

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (server-side only — NEVER expose to browser)
# This key bypasses Row Level Security. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------
# App URL (optional but recommended)
# ------------------------------------

# Public URL of the deployed application (used for email links, CORS, etc.)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ------------------------------------
# Environment
# ------------------------------------
NODE_ENV=production
